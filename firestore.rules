rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile, but only write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId; // Allow creating own profile on signup
      allow update: if request.auth != null && request.auth.uid == userId; // Allow updating own profile
      // Deny delete by default unless needed
      allow delete: if false;
    }

    // Allow authenticated users to create rooms
    match /rooms/{roomId} {
      allow read: if request.auth != null; // Or more specific: check if user is a member
      allow create: if request.auth != null;
      // Allow update/delete only by creator or admin (more complex rule needed)
      allow update, delete: if false; // Start restrictive

      // Messages: Allow members of the room to read/write messages
      // (Requires storing members in the room document or a subcollection)
      match /messages/{messageId} {
        allow read, create: if request.auth != null; // Needs refinement: check room membership
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.senderId; // Allow sender to delete/update own message
      }

      // Members subcollection (if you use one)
      match /members/{userId} {
         allow read: if request.auth != null; // Allow reading member list
         // Allow adding members (e.g., by room admin) or joining (if public)
         allow create: if request.auth != null; // Needs refinement
         // Allow leaving or being removed
         allow delete: if request.auth != null; // Needs refinement
      }
    }
  }
}