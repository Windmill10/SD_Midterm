rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all users (authenticated or not)
    match /public/{fileName=**} {
      allow read: if true;
    }
    
    // Allow authenticated users to upload their own files
    match /user/{userId}/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to upload to chatrooms they're members of
    match /rooms/{roomId}/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data != null;
    }
  }
}